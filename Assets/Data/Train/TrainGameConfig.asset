  tasks:
  - taskType: 0
    title: "\u041F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0441\u043A\u0438\u0439
      \u0432\u0430\u0433\u043E\u043D"
    prompt: "\u041F\u043E\u0434\u044A\u0435\u0434\u044C \u043A \u0441\u0438\u043D\u0435\u043C\u0443
      \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0441\u043A\u043E\u043C\u0443
      \u0432\u0430\u0433\u043E\u043D\u0443, \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0441\u044C
      \u0438 \u043D\u0430\u0436\u043C\u0438 \u0441\u0446\u0435\u043F\u043A\u0443."
  - taskType: 1
    title: "\u041F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430"
    prompt: "\u0414\u043E\u0435\u0434\u044C \u0434\u043E \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B
      \u0441 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0441\u043A\u0438\u043C
      \u0432\u0430\u0433\u043E\u043D\u043E\u043C \u0438 \u043E\u0442\u043A\u0440\u043E\u0439
      \u0434\u0432\u0435\u0440\u0438."
  - taskType: 2
    title: "\u0413\u0440\u0443\u0437\u043E\u0432\u043E\u0439 \u0432\u0430\u0433\u043E\u043D"
    prompt: "\u041F\u043E\u0434\u0446\u0435\u043F\u0438 \u0436\u0451\u043B\u0442\u044B\u0439
      \u0433\u0440\u0443\u0437\u043E\u0432\u043E\u0439 \u0432\u0430\u0433\u043E\u043D."
  - taskType: 3
    title: "\u041F\u043E\u0433\u0440\u0443\u0437\u043A\u0430"
    prompt: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0441\u044C \u0443
      \u0433\u0440\u0443\u0437\u043E\u0432\u043E\u0439 \u0441\u0442\u0430\u043D\u0446\u0438\u0438
      \u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u0438 \u0442\u043E\u0432\u0430\u0440
      \u0432 \u0433\u0440\u0443\u0437\u043E\u0432\u043E\u0439 \u0432\u0430\u0433\u043E\u043D."
  - taskType: 4
    title: "\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430"
    prompt: "\u041F\u0440\u0438\u0432\u0435\u0437\u0438 \u0433\u0440\u0443\u0437
      \u0432 \u0434\u0435\u043F\u043E \u0438 \u0432\u044B\u0433\u0440\u0443\u0437\u0438
      \u0435\u0433\u043E."
  - taskType: 5
    title: "\u041F\u0430\u0441\u0441\u0430\u0436\u0438\u0440"
    prompt: "\u041F\u043E\u0441\u0430\u0434\u0438 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0430
      \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435 \u0438
      \u043E\u0442\u0432\u0435\u0437\u0438 \u0435\u0433\u043E \u0432 \u0434\u0435\u043F\u043E."
  - taskType: 1
    title: "Уровень 2: город"
    prompt: "Доедь до дальней станции Город с пассажирским вагоном и открой двери."
  - taskType: 3
    title: "Уровень 2: дерево"
    prompt: "Остановись у грузовой станции и загрузи дерево в грузовой вагон."
  - taskType: 4
    title: "Уровень 2: доставка дерева"
    prompt: "Привези дерево в депо и выгрузи его."
  - taskType: 3
    title: "Уровень 2: камень"
    prompt: "Доедь до карьера и загрузи камень в грузовой вагон."
  - taskType: 4
    title: "Уровень 2: доставка камня"
    prompt: "Привези камень в депо и выгрузи его."
